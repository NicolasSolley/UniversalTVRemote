<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key><string>Universal Remote</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>com.nicolassolley.universaltvremote</string>
    <key>CFBundleName</key><string>UniversalTVRemote</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.0.64</string>
    <key>CFBundleVersion</key><string>64</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>NSMicrophoneUsageDescription</key><string>Hold the mic button and speak — your voice is sent to the TV so it can act on it.</string>
    <key>NSPhotoLibraryUsageDescription</key><string>Choose a photo to use as your pad's cover art.</string>
    <key>NSLocalNetworkUsageDescription</key><string>Find and control TVs on your local Wi-Fi network.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_roku-ecp._tcp</string>
        <string>_samsungmsf._tcp</string>
        <string>_airplay._tcp</string>
        <string>_googlecast._tcp</string>
        <string>_lg-smart-tv._tcp</string>
        <string>_lg-mrt._tcp</string>
        <string>_androidtvremote2._tcp</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key><true/>
        <key>NSAllowsLocalNetworking</key><true/>
    </dict>
    <key>UILaunchScreen</key><dict/>
    <key>UIRequiredDeviceCapabilities</key><array><string>arm64</string></array>
    <key>UISupportedInterfaceOrientations</key>
    <array><string>UIInterfaceOrientationPortrait</string></array>
</dict>
</plist>
